#!/usr/bin/env bash
# Resolves the parent directory of ShinyDoodle.app
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$APP_DIR" || exit 1

if command -v python3 &>/dev/null; then
    exec python3 start.py
elif command -v python &>/dev/null; then
    exec python start.py
else
    osascript -e 'display dialog "Python 3 is required to run Shiny Doodle. Please install Python 3 from python.org." buttons {"OK"} default button "OK" with icon stop'
fi
